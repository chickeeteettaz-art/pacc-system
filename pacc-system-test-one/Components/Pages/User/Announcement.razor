@code {
    private List<pacc_system_test_one.Models.Announcement> announcements = new();
    private pacc_system_test_one.Models.Announcement? selectedAnnouncement;

    private bool isLoading = true;
    private bool showDetails;

    private string searchTerm = string.Empty;
    private string selectedCategory = "All";
    private string errorMessage = string.Empty;

    private List<string> Categories =>
        announcements
            .Select(a => string.IsNullOrWhiteSpace(a.Category)
                ? "General"
                : a.Category.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c)
            .ToList();

    private List<pacc_system_test_one.Models.Announcement> FilteredAnnouncements
    {
        get
        {
            IEnumerable<pacc_system_test_one.Models.Announcement> query = announcements;

            if (!string.Equals(selectedCategory, "All",
                    StringComparison.OrdinalIgnoreCase))
            {
                query = query.Where(a =>
                    string.Equals(
                        string.IsNullOrWhiteSpace(a.Category)
                            ? "General"
                            : a.Category.Trim(),
                        selectedCategory,
                        StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();

                query = query.Where(a =>
                    Contains(a.Title, term) ||
                    Contains(a.Description, term) ||
                    Contains(a.Location, term) ||
                    Contains(a.Category, term));
            }

            return query
                .OrderByDescending(a => a.AnnouncementDate)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.LoadCurrentUserAsync();

        if (user is null)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await LoadAnnouncementsAsync();
    }

    private async Task LoadAnnouncementsAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            announcements = await AuthService.GetAnnouncementsAsync()
                ?? new List<pacc_system_test_one.Models.Announcement>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Loading announcements failed: {ex}");
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAnnouncement(pacc_system_test_one.Models.Announcement announcement)
    {
        selectedAnnouncement = announcement;
        showDetails = true;
    }

    private void CloseAnnouncement()
    {
        showDetails = false;
        selectedAnnouncement = null;
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedCategory = "All";
    }

    private static bool Contains(string? source, string term) =>
        !string.IsNullOrWhiteSpace(source) &&
        source.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string GetDescriptionPreview(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
            return "Open this announcement to view more details.";

        var text = description.Trim();

        return text.Length <= 150
            ? text
            : text[..150] + "...";
    }

    private static string FormatDate(DateTime date)
    {
        return date == default
            ? "Date to be announced"
            : date.ToLocalTime().ToString("dddd, dd MMMM yyyy");
    }

    private static string GetCategoryIcon(string? category)
    {
        return category?.Trim().ToUpperInvariant() switch
        {
            "EVENT" or "EVENTS" => "bi bi-calendar-event-fill",
            "SERVICE" or "SERVICES" => "bi bi-calendar2-week-fill",
            "MEETING" or "MEETINGS" => "bi bi-people-fill",
            "OUTREACH" => "bi bi-heart-fill",
            "AWARENESS" or "AWARENESS EVENT" => "bi bi-megaphone-fill",
            "URGENT" or "IMPORTANT" => "bi bi-exclamation-circle-fill",
            "CLOSURE" or "ROAD CLOSURE" => "bi bi-cone-striped",
            _ => "bi bi-megaphone-fill"
        };
    }
