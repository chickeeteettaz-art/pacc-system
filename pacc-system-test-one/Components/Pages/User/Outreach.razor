@page "/user/outreach"

@using System
@using System.Linq
@using System.Collections.Generic
@using pacc_system_test_one.Models
@using pacc_system_test_one.Services

@inject FirebaseAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Outreach Programmes | Christian Centre</PageTitle>

<div class="outreach-page">

    <!-- Breadcrumb -->
    <div class="outreach-breadcrumb">
        <span>Christian Centre</span>
        <i class="bi bi-chevron-right"></i>
        <span class="active">Outreach</span>
    </div>

    <!-- Page heading -->
    <div class="outreach-heading">
        <div class="outreach-heading-icon">
            <i class="bi bi-people-fill"></i>
        </div>

        <div class="flex-grow-1">
            <h1>Outreach Programmes</h1>
            <p>
                Discover how Christian Centre serves, supports and connects
                with the community.
            </p>
        </div>

        @if (!isLoading && string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="outreach-total">
                <i class="bi bi-heart-fill me-2"></i>
                @FilteredPrograms.Count
                @(FilteredPrograms.Count == 1 ? "Programme" : "Programmes")
            </div>
        }
    </div>

    <!-- Search and filter -->
    <div class="outreach-toolbar">
        <div class="outreach-search">
            <i class="bi bi-search"></i>

            <input class="form-control"
                   type="search"
                   placeholder="Search outreach programmes..."
                   @bind="searchTerm"
                   @bind:event="oninput" />

            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <button type="button"
                        class="outreach-clear-search"
                        aria-label="Clear search"
                        @onclick="ClearSearch">
                    <i class="bi bi-x-lg"></i>
                </button>
            }
        </div>

        <select class="form-select outreach-sort"
                @bind="selectedSort">
            <option value="Upcoming">Upcoming first</option>
            <option value="Newest">Newest first</option>
            <option value="Oldest">Oldest first</option>
        </select>

        <button type="button"
                class="btn btn-outline-primary outreach-refresh"
                @onclick="LoadProgramsAsync"
                disabled="@isLoading">
            <i class="bi bi-arrow-clockwise me-2"></i>
            Refresh
        </button>
    </div>

    <!-- Error state -->
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="outreach-error">
            <div class="outreach-error-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <div class="flex-grow-1">
                <strong>Unable to load outreach programmes</strong>
                <p>@errorMessage</p>
            </div>

            <button type="button"
                    class="btn btn-primary"
                    @onclick="LoadProgramsAsync">
                <i class="bi bi-arrow-clockwise me-2"></i>
                Try again
            </button>
        </div>
    }

    <!-- Loading state -->
    @if (isLoading)
    {
        <div class="outreach-state-panel">
            <div class="spinner-border text-primary" role="status"></div>
            <h5>Loading outreach programmes</h5>
            <p>Please wait while we retrieve the latest programmes.</p>
        </div>
    }
    else if (string.IsNullOrWhiteSpace(errorMessage) && FilteredPrograms.Count == 0)
    {
        <!-- Empty state -->
        <div class="outreach-state-panel">
            <div class="outreach-empty-icon">
                <i class="bi bi-people"></i>
            </div>

            @if (programs.Count == 0)
            {
                <h3>No outreach programmes yet</h3>
                <p>
                    New community outreach programmes will appear here when
                    they are published by the church administration.
                </p>
            }
            else
            {
                <h3>No matching programmes</h3>
                <p>Try another search term or change the sorting option.</p>

                <button type="button"
                        class="btn btn-outline-primary mt-3"
                        @onclick="ClearSearch">
                    Clear search
                </button>
            }
        </div>
    }
    else if (!isLoading && string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="outreach-results-summary">
            <span>
                Showing <strong>@FilteredPrograms.Count</strong>
                @(FilteredPrograms.Count == 1 ? "programme" : "programmes")
            </span>
        </div>

        <!-- Outreach programme cards -->
        <div class="outreach-grid">
            @foreach (var program in FilteredPrograms)
            {
                <article class="outreach-card" @key="program.OutreachId">

                    <!-- Image -->
                    <button type="button"
                            class="outreach-image-button"
                            aria-label="@($"View image for {program.Title}")"
                            @onclick="() => OpenProgram(program)">

                        @if (!string.IsNullOrWhiteSpace(program.ImageUrl))
                        {
                            <img src="@program.ImageUrl"
                                 alt="@program.Title"
                                 class="outreach-image"
                                 loading="lazy"
                                 @onerror="() => HandleImageError(program)" />
                        }
                        else
                        {
                            <div class="outreach-image-placeholder">
                                <i class="bi bi-people-fill"></i>
                                <span>Outreach Programme</span>
                            </div>
                        }

                        <span class="outreach-image-overlay">
                            <i class="bi bi-arrows-fullscreen"></i>
                            View details
                        </span>
                    </button>

                    <!-- Card body -->
                    <div class="outreach-card-body">

                        <div class="outreach-date">
                            <i class="bi bi-calendar-event"></i>

                            @if (program.Date != default)
                            {
                                @program.Date.ToLocalTime().ToString("dd MMM yyyy")
                            }
                            else
                            {
                                <span>Date to be announced</span>
                            }
                        </div>

                        <h2>@program.Title</h2>

                        <p class="outreach-description">
                            @GetDescriptionPreview(program.Description, program.Content)
                        </p>

                        @if (program.Date != default)
                        {
                            <div class="outreach-date-detail">
                                <i class="bi bi-clock"></i>
                                @program.Date.ToLocalTime().ToString("dddd, HH:mm")
                            </div>
                        }
                    </div>

                    <!-- Card footer -->
                    <div class="outreach-card-footer">
                        <span class="outreach-card-label">
                            <i class="bi bi-heart-fill me-1"></i>
                            Community outreach
                        </span>

                        <button type="button"
                                class="btn outreach-details-button"
                                @onclick="() => OpenProgram(program)">
                            Learn more
                            <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </div>

                </article>
            }
        </div>
    }
</div>

<!-- Programme details modal -->
@if (showDetails && selectedProgram is not null)
{
    <div class="outreach-modal-backdrop"
         @onclick="CloseProgram">

        <section class="outreach-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="outreach-modal-title"
                 @onclick:stopPropagation="true">

            <div class="outreach-modal-header">
                <div>
                    <span class="outreach-modal-eyebrow">
                        <i class="bi bi-heart-fill me-2"></i>
                        CHRISTIAN CENTRE OUTREACH
                    </span>
                </div>

                <button type="button"
                        class="outreach-modal-close"
                        aria-label="Close programme details"
                        @onclick="CloseProgram">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(selectedProgram.ImageUrl))
            {
                <div class="outreach-modal-image-wrapper">
                    <img src="@selectedProgram.ImageUrl"
                         alt="@selectedProgram.Title"
                         class="outreach-modal-image"
                         @onerror="() => HandleImageError(selectedProgram)" />
                </div>
            }

            <div class="outreach-modal-content">

                <div class="outreach-modal-date">
                    <i class="bi bi-calendar-event"></i>

                    @if (selectedProgram.Date != default)
                    {
                        @selectedProgram.Date.ToLocalTime().ToString("dddd, dd MMMM yyyy 'at' HH:mm")
                    }
                    else
                    {
                        <span>Date to be announced</span>
                    }
                </div>

                <h2 id="outreach-modal-title">
                    @selectedProgram.Title
                </h2>

                @if (!string.IsNullOrWhiteSpace(selectedProgram.Description))
                {
                    <div class="outreach-modal-section">
                        <h3>About this programme</h3>
                        <p class="outreach-modal-description">
                            @selectedProgram.Description
                        </p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(selectedProgram.Content))
                {
                    <div class="outreach-modal-section">
                        <h3>Programme details</h3>
                        <div class="outreach-modal-description outreach-content">
                            @selectedProgram.Content
                        </div>
                    </div>
                }

                <div class="outreach-modal-note">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>
                        For more information about participating in this programme,
                        please contact the church administration.
                    </span>
                </div>

            </div>

            <div class="outreach-modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="CloseProgram">
                    Close
                </button>
            </div>

        </section>
    </div>
}

