        }

        .outreach-modal-backdrop {
            padding: 10px;
        }

        .outreach-modal {
            max-height: calc(100vh - 20px);
            border-radius: 14px;
        }

        .outreach-modal-content {
            padding: 20px;
        }

        .outreach-error {
            flex-wrap: wrap;
        }

            .outreach-error .btn {
                width: 100%;
            }
    }
</style>

@code {
    private List<OutreachProgram> programs = new();
    private OutreachProgram? selectedProgram;

    private bool isLoading = true;
    private bool showDetails;

    private string searchTerm = string.Empty;
    private string selectedSort = "Upcoming";
    private string errorMessage = string.Empty;

    // Track failed image URLs to avoid repeatedly rendering broken images.
    private readonly HashSet<string> failedImageUrls =
        new(StringComparer.OrdinalIgnoreCase);

    private List<OutreachProgram> FilteredPrograms
    {
        get
        {
            IEnumerable<OutreachProgram> query = programs;

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();

                query = query.Where(p =>
                    Contains(p.Title, term) ||
                    Contains(p.Description, term) ||
                    Contains(p.Content, term));
            }

            query = selectedSort switch
            {
                "Newest" => query.OrderByDescending(p => p.Date),
                "Oldest" => query.OrderBy(p => p.Date),
                _ => query.OrderBy(p =>
                        p.Date == default || p.Date < DateTime.Now)
                    .ThenBy(p => p.Date)
            };

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await AuthService.LoadCurrentUserAsync();

            if (user is null)
            {
                Navigation.NavigateTo("/login", true);
                return;
            }

            await LoadProgramsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Outreach initialization failed: {ex}");
            errorMessage = ex.Message;
            isLoading = false;
        }
    }

    private async Task LoadProgramsAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            programs = await AuthService.GetOutreachProgramsAsync()
                ?? new List<OutreachProgram>();

            failedImageUrls.Clear();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Loading outreach programmes failed: {ex}");
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenProgram(OutreachProgram program)
    {
        selectedProgram = program;
        showDetails = true;
    }

    private void CloseProgram()
    {
        showDetails = false;
        selectedProgram = null;
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
    }

    private static bool Contains(string? value, string term) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string GetDescriptionPreview(
        string? description,
        string? content)
    {
        var value = !string.IsNullOrWhiteSpace(description)
            ? description.Trim()
            : content?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(value))
            return "Open this programme to view more information.";

        return value.Length <= 145
            ? value
            : value[..145] + "...";
    }

    private void HandleImageError(OutreachProgram program)
    {
        if (!string.IsNullOrWhiteSpace(program.ImageUrl))
        {
            failedImageUrls.Add(program.ImageUrl);
        }

        // Keep the UI stable if an Azure Blob URL is unavailable.
        StateHasChanged();
    }
}