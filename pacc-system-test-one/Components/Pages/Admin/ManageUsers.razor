@page "/admin/users"

@layout AdminLayout

@using Microsoft.JSInterop
@using pacc_system_test_one.Models
@using pacc_system_test_one.Services

@inject FirebaseAuthService AuthService
@inject IJSRuntime JS

<div class="manage-users-page m">

    <!-- PAGE HEADER -->
    <div class="page-header m-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="page-header-icon">
                    <i class="bi bi-people-fill"></i>
                </span>

                <span class="text-primary fw-semibold">
                    Administration
                </span>
            </div>

            <h1 class="page-title mb-1">
                Manage Users
            </h1>

            <p class="page-description mb-0">
                View and manage registered users and their account roles.
            </p>
        </div>

        <button class="btn btn-primary refresh-button"
                @onclick="LoadUsersAsync"
                disabled="@loading">

            @if (loading)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
            }
            else
            {
                <i class="bi bi-arrow-clockwise me-2"></i>
            }

            Refresh
        </button>

    </div>


    <!-- ERROR MESSAGE -->
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-start gap-3 m-4"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill fs-5"></i>

            <div class="flex-grow-1">
                <strong>Unable to complete the request.</strong>

                <div class="small mt-1">
                    @errorMessage
                </div>
            </div>

            <button type="button"
                    class="btn-close"
                    @onclick="ClearMessages">
            </button>

        </div>
    }


    <!-- SUCCESS MESSAGE -->
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-3 m-4"
             role="alert">

            <i class="bi bi-check-circle-fill fs-5"></i>

            <div class="flex-grow-1">
                @successMessage
            </div>

            <button type="button"
                    class="btn-close"
                    @onclick="ClearMessages">
            </button>

        </div>
    }


    <!-- LOADING -->
    @if (loading && Users.Count == 0)
    {
        <div class="loading-card m-4">

            <div class="spinner-border text-primary"
                 role="status">
            </div>

            <h5 class="mt-3 mb-1">
                Loading users
            </h5>

            <p class="text-muted mb-0">
                Retrieving registered users from Firebase...
            </p>

        </div>
    }
    else
    {

        <!-- STATISTICS -->
        <div class="row g-3 mb-4">

            <!-- TOTAL USERS -->
            <div class="col-12 col-sm-6 col-xl-4">

                <div class="user-stat-card">

                    <div class="stat-content">

                        <span class="stat-label">
                            Total Users
                        </span>

                        <h2>
                            @Users.Count
                        </h2>

                        <small>
                            Registered accounts
                        </small>

                    </div>

                    <div class="stat-icon users">
                        <i class="bi bi-people-fill"></i>
                    </div>

                </div>

            </div>


            <!-- REGULAR USERS -->
            <div class="col-12 col-sm-6 col-xl-4">

                <div class="user-stat-card">

                    <div class="stat-content">

                        <span class="stat-label">
                            Regular Users
                        </span>

                        <h2>
                            @RegularUserCount
                        </h2>

                        <small>
                            Standard accounts
                        </small>

                    </div>

                    <div class="stat-icon regular">
                        <i class="bi bi-person-fill"></i>
                    </div>

                </div>

            </div>


            <!-- ADMINISTRATORS -->
            <div class="col-12 col-sm-6 col-xl-4">

                <div class="user-stat-card">

                    <div class="stat-content">

                        <span class="stat-label">
                            Administrators
                        </span>

                        <h2>
                            @AdminCount
                        </h2>

                        <small>
                            Administrative accounts
                        </small>

                    </div>

                    <div class="stat-icon admin">
                        <i class="bi bi-shield-check"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- USER MANAGEMENT CARD -->
        <div class="card user-management-card">

            <!-- TOOLBAR -->
            <div class="user-toolbar">

                <div>

                    <h5 class="fw-bold mb-1">
                        Registered Users
                    </h5>

                    <span class="text-muted small">
                        @Users.Count user(s) displayed
                    </span>

                </div>


                <div class="user-toolbar-controls">

                    <!-- SEARCH -->
                    <div class="user-search">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               class="form-control"
                               placeholder="Search users..."
                               @bind="SearchTerm"
                               @bind:event="oninput" />

                    </div>


                    <!-- ROLE FILTER -->
                    <select class="form-select user-filter"
                            @bind="SelectedRole">

                        <option value="All">
                            All roles
                        </option>

                        <option value="User">
                            Users
                        </option>

                        <option value="Admin">
                            Administrators
                        </option>

                    </select>

                </div>

            </div>


            <!-- ACTIVE FILTERS -->
            @if (!string.IsNullOrWhiteSpace(SearchTerm)
                || SelectedRole != "All")
            {
                <div class="active-filters">

                    <span class="text-muted small">
                        Active filters:
                    </span>

                    @if (!string.IsNullOrWhiteSpace(SearchTerm))
                    {
                        <span class="filter-pill">

                            <i class="bi bi-search"></i>

                            @SearchTerm

                            <button type="button"
                                    @onclick="ClearSearch">
                                <i class="bi bi-x"></i>
                            </button>

                        </span>
                    }

                    @if (SelectedRole != "All")
                    {
                        <span class="filter-pill">

                            <i class="bi bi-shield"></i>

                            @SelectedRole

                            <button type="button"
                                    @onclick="ClearRoleFilter">
                                <i class="bi bi-x"></i>
                            </button>

                        </span>
                    }

                    <button class="btn btn-sm btn-link text-decoration-none"
                            @onclick="ClearFilters">

                        Clear all

                    </button>

                </div>
            }


            <!-- EMPTY STATE -->
            @if (!FilteredUsers.Any())
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <h5>
                        No users found
                    </h5>

                    @if (Users.Count == 0)
                    {
                        <p class="text-muted">
                            There are currently no registered users.
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">
                            Try changing your search or role filter.
                        </p>

                        <button class="btn btn-outline-primary btn-sm"
                                @onclick="ClearFilters">

                            <i class="bi bi-arrow-counterclockwise me-2"></i>

                            Clear Filters

                        </button>
                    }

                </div>
            }
            else
            {

                <!-- TABLE -->
                <div class="table-responsive">

                    <table class="table user-table align-middle mb-0">

                        <thead>

                            <tr>

                                <th>
                                    User
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Firebase UID
                                </th>

                                <th class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var user in FilteredUsers)
                            {
                                <tr>

                                    <!-- USER -->
                                    <td>

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="user-list-avatar">
                                                @user.Initials
                                            </div>

                                            <div>

                                                <div class="fw-semibold user-name">

                                                    @(string.IsNullOrWhiteSpace(user.FullName)
                                                        ? "Unnamed User"
                                                        : user.FullName)

                                                </div>

                                                <small class="text-muted">

                                                    @user.FirstName @user.LastName

                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- EMAIL -->
                                    <td>

                                        <div class="email-cell">

                                            <i class="bi bi-envelope me-2"></i>

                                            @user.EmailAddress

                                        </div>

                                    </td>


                                    <!-- ROLE -->
                                    <td>

                                        @if (IsAdmin(user))
                                        {
                                            <span class="role-badge admin-role">

                                                <i class="bi bi-shield-check"></i>

                                                Administrator

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="role-badge user-role">

                                                <i class="bi bi-person"></i>

                                                User

                                            </span>
                                        }

                                    </td>


                                    <!-- FIREBASE UID -->
                                    <td>

                                        <code class="firebase-uid"
                                              title="@user.FirebaseUid">

                                            @ShortenUid(
                                                string.IsNullOrWhiteSpace(user.FirebaseUid)
                                                    ? user.UserId
                                                    : user.FirebaseUid)

                                        </code>

                                    </td>


                                    <!-- ACTIONS -->
                                    <td class="text-end">

                                        <div class="dropdown">

                                            <button class="btn btn-light action-button dropdown-toggle"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false">

                                                <i class="bi bi-three-dots"></i>

                                                <span class="d-none d-lg-inline ms-1">
                                                    Actions
                                                </span>

                                            </button>


                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                                                @if (!IsAdmin(user))
                                                {
                                                    <li>

                                                        <button class="dropdown-item"
                                                                @onclick="() => MakeAdminAsync(user)">

                                                            <i class="bi bi-shield-plus me-2 text-primary"></i>

                                                            Make Administrator

                                                        </button>

                                                    </li>
                                                }
                                                else
                                                {
                                                    <li>

                                                        <button class="dropdown-item"
                                                                @onclick="() => MakeUserAsync(user)">

                                                            <i class="bi bi-person-down me-2 text-warning"></i>

                                                            Remove Administrator

                                                        </button>

                                                    </li>
                                                }


                                                <li>
                                                    <hr class="dropdown-divider" />
                                                </li>


                                                <li>

                                                    <button class="dropdown-item text-danger"
                                                            @onclick="() => DeleteUserAsync(user)">

                                                        <i class="bi bi-trash3 me-2"></i>

                                                        Delete Profile

                                                    </button>

                                                </li>

                                            </ul>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- TABLE FOOTER -->
                <div class="table-footer">

                    <div class="text-muted small">

                        Showing
                        <strong>@Users.Count</strong>
                        of
                        <strong>@Users.Count</strong>
                        users

                    </div>

                    <div class="text-muted small">

                        <i class="bi bi-database me-1"></i>

                        Firebase Firestore

                    </div>

                </div>

            }

        </div>

    }

</div>


