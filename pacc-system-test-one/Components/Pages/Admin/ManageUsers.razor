@code {

    private List<User> Users { get; set; } = new();

    private string SearchTerm { get; set; } = string.Empty;

    private string SelectedRole { get; set; } = "All";

    private bool loading = true;

    private string errorMessage = string.Empty;

    private string successMessage = string.Empty;


    /* -------------------------------------------------------
       FILTERED USERS
    ------------------------------------------------------- */

    private IEnumerable<User> FilteredUsers =>
        Users
            .Where(user =>
                string.IsNullOrWhiteSpace(SearchTerm)
                ||
                (user.FirstName?.Contains(
                    SearchTerm,
                    StringComparison.OrdinalIgnoreCase) ?? false)
                ||
                (user.LastName?.Contains(
                    SearchTerm,
                    StringComparison.OrdinalIgnoreCase) ?? false)
                ||
                (user.EmailAddress?.Contains(
                    SearchTerm,
                    StringComparison.OrdinalIgnoreCase) ?? false)
                ||
                (user.FirebaseUid?.Contains(
                    SearchTerm,
                    StringComparison.OrdinalIgnoreCase) ?? false)
                ||
                (user.UserId?.Contains(
                    SearchTerm,
                    StringComparison.OrdinalIgnoreCase) ?? false)
            )
            .Where(user =>
                SelectedRole == "All"
                ||
                user.UserType.Equals(
                    SelectedRole,
                    StringComparison.OrdinalIgnoreCase)
            );


    /* -------------------------------------------------------
       STATISTICS
    ------------------------------------------------------- */

    private int AdminCount =>
        Users.Count(IsAdmin);


    private int RegularUserCount =>
        Users.Count(user => !IsAdmin(user));


    /* -------------------------------------------------------
       INITIALIZATION
    ------------------------------------------------------- */

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }


    /* -------------------------------------------------------
       LOAD USERS
    ------------------------------------------------------- */

    private async Task LoadUsersAsync()
    {
        loading = true;

        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            Users = await AuthService.GetUsersAsync();

            Users ??= new List<User>();
        }
        catch (Exception ex)
        {
            errorMessage = GetFriendlyErrorMessage(ex);
        }
        finally
        {
            loading = false;
        }
    }


    /* -------------------------------------------------------
       ROLE CHECK
    ------------------------------------------------------- */

    private bool IsAdmin(User user)
    {
        return user.UserType.Equals(
            "Admin",
            StringComparison.OrdinalIgnoreCase);
    }


    /* -------------------------------------------------------
       MAKE ADMIN
    ------------------------------------------------------- */

    private async Task MakeAdminAsync(User user)
    {
        await ChangeRoleAsync(user, "Admin");
    }


    /* -------------------------------------------------------
       MAKE REGULAR USER
    ------------------------------------------------------- */

    private async Task MakeUserAsync(User user)
    {
        await ChangeRoleAsync(user, "User");
    }


    /* -------------------------------------------------------
       CHANGE ROLE
    ------------------------------------------------------- */

    private async Task ChangeRoleAsync(
        User user,
        string newRole)
    {
        ClearMessages();

        if (user.UserId == AuthService.CurrentUser?.Uid
            && newRole != "Admin")
        {
            errorMessage =
                "You cannot remove administrator access from your own account.";

            return;
        }

        string action;

        if (newRole.Equals(
            "Admin",
            StringComparison.OrdinalIgnoreCase))
        {
            action = $"make {GetUserDisplayName(user)} an administrator";
        }
        else
        {
            action = $"remove administrator access from {GetUserDisplayName(user)}";
        }


        var confirmed = await ConfirmActionAsync(
            $"Are you sure you want to {action}?");

        if (!confirmed)
        {
            return;
        }


        try
        {
            await AuthService.UpdateUserRoleAsync(
                user.UserId,
                newRole);

            user.UserType = newRole;

            successMessage =
                $"{GetUserDisplayName(user)} is now a {newRole}.";

            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = GetFriendlyErrorMessage(ex);
        }
    }


    /* -------------------------------------------------------
       DELETE PROFILE
    ------------------------------------------------------- */

    private async Task DeleteUserAsync(User user)
    {
        ClearMessages();


        if (user.UserId == AuthService.CurrentUser?.Uid)
        {
            errorMessage =
                "You cannot delete your own profile from the user management page.";

            return;
        }


        var confirmed = await ConfirmActionAsync(
            $"Delete the Firestore profile for {GetUserDisplayName(user)} ({user.EmailAddress})?");


        if (!confirmed)
        {
            return;
        }


        try
        {
            await AuthService.DeleteUserProfileAsync(
                user.UserId);

            Users.Remove(user);

            successMessage =
                $"The profile for {GetUserDisplayName(user)} has been deleted.";

            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = GetFriendlyErrorMessage(ex);
        }
    }


    /* -------------------------------------------------------
       JAVASCRIPT CONFIRMATION
    ------------------------------------------------------- */

    private async Task<bool> ConfirmActionAsync(
        string message)
    {
        return await JS.InvokeAsync<bool>(
            "confirm",
            message);
    }


    /* -------------------------------------------------------
       SEARCH / FILTER
    ------------------------------------------------------- */

    private void ClearSearch()
    {
        SearchTerm = string.Empty;
    }


    private void ClearRoleFilter()
    {
        SelectedRole = "All";
    }


    private void ClearFilters()
    {
        SearchTerm = string.Empty;
        SelectedRole = "All";
    }


    /* -------------------------------------------------------
       MESSAGES
    ------------------------------------------------------- */

    private void ClearMessages()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }


    /* -------------------------------------------------------
       DISPLAY NAME
    ------------------------------------------------------- */

    private string GetUserDisplayName(User user)
    {
        if (!string.IsNullOrWhiteSpace(user.FullName))
        {
            return user.FullName;
        }

        if (!string.IsNullOrWhiteSpace(user.EmailAddress))
        {
            return AuthService.GetDisplayName(
                user.EmailAddress);
        }

        return "User";
    }


    /* -------------------------------------------------------
       SHORTEN FIREBASE UID
    ------------------------------------------------------- */

    private string ShortenUid(string uid)
    {
        if (string.IsNullOrWhiteSpace(uid))
        {
            return "N/A";
        }

        if (uid.Length <= 16)
        {
            return uid;
        }

        return $"{uid[..8]}...{uid[^6..]}";
    }


    /* -------------------------------------------------------
       FRIENDLY ERROR
    ------------------------------------------------------- */

    private string GetFriendlyErrorMessage(Exception ex)
    {
        var message = ex.Message;

        if (message.Contains(
            "Missing or insufficient permissions",
            StringComparison.OrdinalIgnoreCase))
        {
            return
                "Firebase denied this operation. Check your Firestore Security Rules and make sure the logged-in account has administrator access.";
        }

        if (message.Contains(
            "You must be logged in",
            StringComparison.OrdinalIgnoreCase))
        {
            return
                "Your Firebase session has expired. Please log in again.";
        }

        return message;
    }

}