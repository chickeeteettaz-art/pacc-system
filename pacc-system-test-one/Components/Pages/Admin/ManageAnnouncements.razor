@page "/admin/announcements"

@layout AdminLayout

@using Microsoft.JSInterop
@using pacc_system_test_one.Models
@using pacc_system_test_one.Services

@inject FirebaseAuthService AuthService
@inject IJSRuntime JS

<div class="announcements-page">

    <!-- PAGE HEADER -->

    <div class="page-header mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <span class="page-header-icon">
                    <i class="bi bi-megaphone-fill"></i>
                </span>

                <span class="text-primary fw-semibold">
                    Administration
                </span>

            </div>

            <h1 class="page-title mb-1">
                Announcements
            </h1>

            <p class="page-description mb-0">
                Create and manage announcements for the Christian Centre.
            </p>

        </div>


        <button class="btn btn-primary"
                @onclick="OpenCreateForm">

            <i class="bi bi-plus-lg me-2"></i>

            New Announcement

        </button>

    </div>


    <!-- ALERTS -->
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-start gap-3">

            <i class="bi bi-exclamation-triangle-fill"></i>

            <div class="flex-grow-1">

                <strong>Unable to complete the request.</strong>

                <div class="small mt-1">
                    @errorMessage
                </div>

            </div>

            <button class="btn-close"
                    @onclick="ClearMessages">
            </button>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success d-flex align-items-center gap-3">

            <i class="bi bi-check-circle-fill"></i>

            <div class="flex-grow-1">
                @successMessage
            </div>

            <button class="btn-close"
                    @onclick="ClearMessages">
            </button>

        </div>
    }


    <!-- STATISTICS -->

    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">

            <div class="announcement-stat-card">

                <div>

                    <span>
                        Total Announcements
                    </span>

                    <h2>
                        @Announcements.Count
                    </h2>

                </div>

                <div class="stat-icon">
                    <i class="bi bi-megaphone-fill"></i>
                </div>

            </div>

        </div>


        <div class="col-12 col-md-4">

            <div class="announcement-stat-card">

                <div>

                    <span>
                        Upcoming
                    </span>

                    <h2>
                        @UpcomingCount
                    </h2>

                </div>

                <div class="stat-icon upcoming">
                    <i class="bi bi-calendar-event"></i>
                </div>

            </div>

        </div>


        <div class="col-12 col-md-4">

            <div class="announcement-stat-card">

                <div>

                    <span>
                        Categories
                    </span>

                    <h2>
                        @CategoryCount
                    </h2>

                </div>

                <div class="stat-icon categories">
                    <i class="bi bi-tags-fill"></i>
                </div>

            </div>

        </div>

    </div>


    <!-- CREATE / EDIT FORM -->
    @if (showForm)
    {
        <div class="card announcement-form-card mb-4">

            <div class="card-header">

                <div>

                    <h5 class="mb-1 fw-bold">

                        @if (editingAnnouncement)
                        {
                            <i class="bi bi-pencil-square me-2"></i>
                            <span>Edit Announcement</span>
                        }
                        else
                        {
                            <i class="bi bi-plus-circle me-2"></i>
                            <span>Create Announcement</span>
                        }

                    </h5>

                    <small class="text-muted">
                        @if (editingAnnouncement)
                        {
                            <span>Update the announcement details below.</span>
                        }
                        else
                        {
                            <span>Enter the details for the new announcement.</span>
                        }
                    </small>

                </div>


                <button class="btn-close"
                        @onclick="CloseForm">
                </button>

            </div>


            <div class="card-body">

                <div class="row g-3">

                    <!-- TITLE -->

                    <div class="col-12">

                        <label class="form-label">
                            Title
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Announcement title"
                               @bind="formTitle" />

                    </div>


                    <!-- CATEGORY -->

                    <div class="col-12 col-md-6">

                        <label class="form-label">
                            Category
                        </label>

                        <select class="form-select"
                                @bind="formCategory">

                            <option value="General">
                                General
                            </option>

                            <option value="Meetings">
                                Meetings
                            </option>

                            <option value="Awareness Events">
                                Awareness Events
                            </option>

                            <option value="Worship">
                                Worship
                            </option>

                            <option value="Outreach">
                                Outreach
                            </option>

                        </select>

                    </div>


                    <!-- DATE -->

                    <div class="col-12 col-md-6">

                        <label class="form-label">
                            Announcement Date
                        </label>

                        <input type="datetime-local"
                               class="form-control"
                               @bind="formDate" />

                    </div>


                    <!-- LOCATION -->

                    <div class="col-12">

                        <label class="form-label">
                            Location
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="e.g. Main Church Auditorium"
                               @bind="formLocation" />

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="col-12">

                        <label class="form-label">
                            Description
                        </label>

                        <textarea class="form-control"
                                  rows="5"
                                  placeholder="Write the announcement details..."
                                  @bind="formDescription">
                        </textarea>

                    </div>

                </div>

            </div>


            <div class="card-footer d-flex justify-content-end gap-2">

                <button class="btn btn-light"
                        @onclick="CloseForm"
                        disabled="@saving">

                    Cancel

                </button>


                <button class="btn btn-primary"
                        @onclick="SaveAnnouncementAsync"
                        disabled="@saving">

                    @if (saving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>

                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg me-2"></i>

                        <span>
                            @(editingAnnouncement
                                ? "Update Announcement"
                                : "Create Announcement")
                        </span>
                    }

                </button>

            </div>

        </div>
    }


    <!-- SEARCH AND FILTER -->

    <div class="card announcement-list-card">

        <div class="announcement-toolbar">

            <div>

                <h5 class="fw-bold mb-1">
                    All Announcements
                </h5>

                <small class="text-muted">
                    @Announcements.Count announcement(s)
                </small>

            </div>


            <div class="announcement-controls">

                <div class="announcement-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           class="form-control"
                           placeholder="Search announcements..."
                           @bind="searchTerm"
                           @bind:event="oninput" />

                </div>


                <select class="form-select"
                        @bind="selectedCategory">

                    <option value="All">
                        All Categories
                    </option>

                    <option value="General">
                        General
                    </option>

                    <option value="Meetings">
                        Meetings
                    </option>

                    <option value="Awareness Events">
                        Awareness Events
                    </option>

                    <option value="Worship">
                        Worship
                    </option>

                    <option value="Outreach">
                        Outreach
                    </option>

                </select>

            </div>

        </div>


        @if (loading)
        {
            <div class="loading-state">

                <div class="spinner-border text-primary"></div>

                <h5 class="mt-3">
                    Loading announcements...
                </h5>

            </div>
        }
        else if (!FilteredAnnouncements.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="bi bi-megaphone"></i>
                </div>

                <h5>
                    No announcements found
                </h5>

                <p class="text-muted">
                    Create your first announcement or change your filters.
                </p>

                <button class="btn btn-primary"
                        @onclick="OpenCreateForm">

                    <i class="bi bi-plus-lg me-2"></i>

                    Create Announcement

                </button>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table announcement-table align-middle mb-0">

                    <thead>

                        <tr>

                            <th>
                                Announcement
                            </th>

                            <th>
                                Category
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Location
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var announcement in FilteredAnnouncements)
                        {
                            <tr>

                                <!-- TITLE -->

                                <td>

                                    <div class="announcement-title">

                                        <div class="announcement-icon">

                                            <i class="bi bi-megaphone-fill"></i>

                                        </div>

                                        <div>

                                            <strong>
                                                @announcement.Title
                                            </strong>

                                            <small>
                                                @GetShortDescription(
                                                    announcement.Description)
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- CATEGORY -->

                                <td>

                                    <span class="category-badge">

                                        @announcement.Category

                                    </span>

                                </td>


                                <!-- DATE -->

                                <td>

                                    <div class="date-cell">

                                        <i class="bi bi-calendar3"></i>

                                        <div>

                                            <strong>
                                                @announcement.AnnouncementDate.ToString("dd MMM yyyy")
                                            </strong>

                                            <small>
                                                @announcement.AnnouncementDate.ToString("HH:mm")
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- LOCATION -->

                                <td>

                                    @if (string.IsNullOrWhiteSpace(
                                        announcement.Location))
                                    {
                                        <span class="text-muted">
                                            Not specified
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="location-cell">

                                            <i class="bi bi-geo-alt"></i>

                                            @announcement.Location

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-end">

                                    <div class="dropdown">

                                        <button class="btn btn-light action-button dropdown-toggle"
                                                type="button"
                                                data-bs-toggle="dropdown">

                                            <i class="bi bi-three-dots"></i>

                                        </button>


                                        <ul class="dropdown-menu dropdown-menu-end">

                                            <li>

                                                <button class="dropdown-item"
                                                        @onclick="() => ViewAnnouncement(announcement)">

                                                    <i class="bi bi-eye me-2"></i>

                                                    View

                                                </button>

                                            </li>


                                            <li>

                                                <button class="dropdown-item"
                                                        @onclick="() => EditAnnouncement(announcement)">

                                                    <i class="bi bi-pencil me-2"></i>

                                                    Edit

                                                </button>

                                            </li>


                                            <li>
                                                <hr class="dropdown-divider" />
                                            </li>


                                            <li>

                                                <button class="dropdown-item text-danger"
                                                        @onclick="() => DeleteAnnouncementAsync(announcement)">

                                                    <i class="bi bi-trash3 me-2"></i>

                                                    Delete

                                                </button>

                                            </li>

                                        </ul>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>


    <!-- VIEW ANNOUNCEMENT -->
    @if (selectedAnnouncement != null)
    {
        <div class="announcement-overlay"
             @onclick="CloseAnnouncementViewer">

            <div class="announcement-viewer"
                 @onclick:stopPropagation="true">

                <div class="viewer-header">

                    <div>

                        <span class="category-badge">
                            @selectedAnnouncement.Category
                        </span>

                        <h3 class="mt-3 mb-0">
                            @selectedAnnouncement.Title
                        </h3>

                    </div>

                    <button class="btn-close"
                            @onclick="CloseAnnouncementViewer">
                    </button>

                </div>


                <div class="viewer-body">

                    <div class="viewer-info">

                        <div>

                            <i class="bi bi-calendar3"></i>

                            <div>

                                <small>
                                    Date
                                </small>

                                <strong>
                                    @selectedAnnouncement.AnnouncementDate.ToString("dd MMMM yyyy")
                                </strong>

                            </div>

                        </div>


                        <div>

                            <i class="bi bi-clock"></i>

                            <div>

                                <small>
                                    Time
                                </small>

                                <strong>
                                    @selectedAnnouncement.AnnouncementDate.ToString("HH:mm")
                                </strong>

                            </div>

                        </div>


                        <div>

                            <i class="bi bi-geo-alt"></i>

                            <div>

                                <small>
                                    Location
                                </small>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(
                                        selectedAnnouncement.Location)
                                        ? "Not specified"
                                        : selectedAnnouncement.Location)
                                </strong>

                            </div>

                        </div>

                    </div>


                    <div class="viewer-description">

                        <h6>
                            Description
                        </h6>

                        <p>
                            @selectedAnnouncement.Description
                        </p>

                    </div>

                </div>


                <div class="viewer-footer">

                    <button class="btn btn-light"
                            @onclick="CloseAnnouncementViewer">

                        Close

                    </button>


                    <button class="btn btn-primary"
                            @onclick="() => EditAnnouncement(selectedAnnouncement)">

                        <i class="bi bi-pencil me-2"></i>

                        Edit Announcement

                    </button>

                </div>

            </div>

        </div>
    }

</div>


