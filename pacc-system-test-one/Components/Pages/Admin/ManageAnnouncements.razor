</style>


@code {

    private List<Announcement> Announcements { get; set; } = new();

    private string searchTerm = string.Empty;

    private string selectedCategory = "All";

    private bool loading = true;

    private bool saving = false;

    private bool showForm = false;

    private bool editingAnnouncement = false;

    private string errorMessage = string.Empty;

    private string successMessage = string.Empty;


    private Announcement? selectedAnnouncement;


    private string formAnnouncementId = string.Empty;

    private string formTitle = string.Empty;

    private string formDescription = string.Empty;

    private string formLocation = string.Empty;

    private string formCategory = "General";

    private DateTime formDate = DateTime.Now;


    private IEnumerable<Announcement> FilteredAnnouncements =>
        Announcements
            .Where(a =>
                string.IsNullOrWhiteSpace(searchTerm)
                ||
                a.Title.Contains(
                    searchTerm,
                    StringComparison.OrdinalIgnoreCase)
                ||
                a.Description.Contains(
                    searchTerm,
                    StringComparison.OrdinalIgnoreCase)
                ||
                a.Location.Contains(
                    searchTerm,
                    StringComparison.OrdinalIgnoreCase)
            )
            .Where(a =>
                selectedCategory == "All"
                ||
                a.Category.Equals(
                    selectedCategory,
                    StringComparison.OrdinalIgnoreCase)
            )
            .OrderByDescending(
                a => a.AnnouncementDate);


    private int UpcomingCount =>
        Announcements.Count(
            a => a.AnnouncementDate >= DateTime.Now);


    private int CategoryCount =>
        Announcements
            .Select(a => a.Category)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();


    protected override async Task OnInitializedAsync()
    {
        await LoadAnnouncementsAsync();
    }


    private async Task LoadAnnouncementsAsync()
    {
        loading = true;

        errorMessage = string.Empty;

        try
        {
            Announcements =
                await AuthService.GetAnnouncementsAsync();

            Announcements ??= new List<Announcement>();
        }
        catch (Exception ex)
        {
            errorMessage = GetFriendlyErrorMessage(ex);
        }
        finally
        {
            loading = false;
        }
    }


    private void OpenCreateForm()
    {
        ClearMessages();

        editingAnnouncement = false;

        formAnnouncementId = string.Empty;

        formTitle = string.Empty;

        formDescription = string.Empty;

        formLocation = string.Empty;

        formCategory = "General";

        formDate = DateTime.Now;

        showForm = true;

        selectedAnnouncement = null;
    }


    private void EditAnnouncement(
        Announcement announcement)
    {
        ClearMessages();

        editingAnnouncement = true;

        formAnnouncementId =
            announcement.AnnouncementId;

        formTitle =
            announcement.Title;

        formDescription =
            announcement.Description;

        formLocation =
            announcement.Location;

        formCategory =
            announcement.Category;

        formDate =
            announcement.AnnouncementDate;

        showForm = true;

        selectedAnnouncement = null;
    }


    private async Task SaveAnnouncementAsync()
    {
        ClearMessages();

        if (string.IsNullOrWhiteSpace(formTitle))
        {
            errorMessage =
                "Please enter an announcement title.";

            return;
        }


        if (string.IsNullOrWhiteSpace(formDescription))
        {
            errorMessage =
                "Please enter an announcement description.";

            return;
        }


        if (string.IsNullOrWhiteSpace(formCategory))
        {
            errorMessage =
                "Please select an announcement category.";

            return;
        }


        saving = true;

        try
        {
            if (editingAnnouncement)
            {
                await AuthService.UpdateAnnouncementAsync(
                    formAnnouncementId,
                    formTitle.Trim(),
                    formDescription.Trim(),
                    formDate,
                    formLocation.Trim(),
                    formCategory);

                successMessage =
                    "Announcement updated successfully.";
            }
            else
            {
                await AuthService.CreateAnnouncementAsync(
                    formTitle.Trim(),
                    formDescription.Trim(),
                    formDate,
                    formLocation.Trim(),
                    formCategory);

                successMessage =
                    "Announcement created successfully.";
            }


            showForm = false;

            await LoadAnnouncementsAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                GetFriendlyErrorMessage(ex);
        }
        finally
        {
            saving = false;
        }
    }


    private async Task DeleteAnnouncementAsync(
        Announcement announcement)
    {
        ClearMessages();

        var confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"Are you sure you want to delete \"{announcement.Title}\"?");


        if (!confirmed)
        {
            return;
        }


        try
        {
            await AuthService.DeleteAnnouncementAsync(
                announcement.AnnouncementId);

            Announcements.Remove(
                announcement);

            successMessage =
                "Announcement deleted successfully.";
        }
        catch (Exception ex)
        {
            errorMessage =
                GetFriendlyErrorMessage(ex);
        }
    }


    private void ViewAnnouncement(
        Announcement announcement)
    {
        selectedAnnouncement =
            announcement;

        showForm = false;

        ClearMessages();
    }


    private void CloseAnnouncementViewer()
    {
        selectedAnnouncement = null;
    }


    private void CloseForm()
    {
        showForm = false;

        editingAnnouncement = false;
    }


    private string GetShortDescription(
        string description)
    {
        if (string.IsNullOrWhiteSpace(description))
        {
            return "No description";
        }

        if (description.Length <= 80)
        {
            return description;
        }

        return $"{description[..80]}...";
    }


    private void ClearMessages()
    {
        errorMessage = string.Empty;

        successMessage = string.Empty;
    }


    private string GetFriendlyErrorMessage(
        Exception ex)
    {
        var message = ex.Message;

        if (message.Contains(
            "Missing or insufficient permissions",
            StringComparison.OrdinalIgnoreCase))
        {
            return
                "Firebase denied this operation. Make sure you are logged in as an administrator and that your Firestore Security Rules allow administrators to manage announcements.";
        }

        if (message.Contains(
            "You must be logged in",
            StringComparison.OrdinalIgnoreCase))
        {
            return
                "Your Firebase session has expired. Please log in again.";
        }

        return message;
    }

}