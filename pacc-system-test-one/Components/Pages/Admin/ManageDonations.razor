@page "/admin/donations"
@layout AdminLayout

@using pacc_system_test_one.Models
@using pacc_system_test_one.Services
@using Microsoft.JSInterop

@inject FirebaseAuthService AuthService
@inject IJSRuntime JS

<div class="donations-page">

    <div class="page-heading">
        <div>
            <div class="heading-label">
                <i class="bi bi-wallet2"></i>
                Administration
            </div>

            <h1>Manage Donations</h1>
            <p>View and manage donations made to the Christian Centre.</p>
        </div>

        <div class="heading-actions">
            <button class="btn btn-outline-secondary"
                    @onclick="LoadDonationsAsync"
                    disabled="@loading">
                <i class="bi bi-arrow-clockwise me-2"></i>
                Refresh
            </button>

            <button class="btn btn-primary"
                    @onclick="OpenCreateForm">
                <i class="bi bi-plus-lg me-2"></i>
                Add Donation
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-start gap-2">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <div class="flex-grow-1">
                <strong>Unable to complete the request.</strong>
                <div>@errorMessage</div>
            </div>
            <button class="btn-close"
                    @onclick="ClearMessages">
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill"></i>
            <span class="flex-grow-1">@successMessage</span>
            <button class="btn-close"
                    @onclick="ClearMessages">
            </button>
        </div>
    }

    @if (!AuthService.IsAdmin)
    {
        <div class="alert alert-warning">
            You must be logged in as an administrator to manage donations.
        </div>
    }
    else
    {
        <!-- SUMMARY CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <div class="donation-stat-card">
                    <div>
                        <span>Total Donations</span>
                        <h2>@Donations.Count</h2>
                    </div>
                    <div class="stat-icon blue">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="donation-stat-card">
                    <div>
                        <span>Total Amount</span>
                        <h2>@TotalAmount.ToString("C2", SouthAfricanCulture)</h2>
                    </div>
                    <div class="stat-icon green">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="donation-stat-card">
                    <div>
                        <span>This Month</span>
                        <h2>@ThisMonthAmount.ToString("C2", SouthAfricanCulture)</h2>
                    </div>
                    <div class="stat-icon purple">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- CREATE / EDIT FORM -->
        @if (showForm)
        {
            <div class="card donation-form-card mb-4">
                <div class="card-header">
                    <div>
                        <h5 class="mb-1">
                            @(editingDonation ? "Edit Donation" : "Add Donation")
                        </h5>
                        <small class="text-muted">
                            Enter the donation record details.
                        </small>
                    </div>

                    <button class="btn-close"
                            @onclick="CloseForm"
                            disabled="@saving">
                    </button>
                </div>

                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-12 col-md-6">
                            <label class="form-label">Donor name</label>
                            <input class="form-control"
                                   @bind="formDonorName"
                                   placeholder="Donor name or Anonymous" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">User ID (optional)</label>
                            <input class="form-control"
                                   @bind="formUserId"
                                   placeholder="Firebase UID" />
                            <small class="text-muted">
                                Leave blank for an anonymous or manually recorded donation.
                            </small>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Amount (ZAR)</label>
                            <input type="number"
                                   class="form-control"
                                   min="0.01"
                                   step="0.01"
                                   @bind="formAmount" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Donation date</label>
                            <input type="datetime-local"
                                   class="form-control"
                                   @bind="formDate" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Giving type</label>
                            <select class="form-select"
                                    @bind="formGivingType">
                                <option value="General">General</option>
                                <option value="Tithes">Tithes</option>
                                <option value="Offering">Offering</option>
                                <option value="Building Fund">Building Fund</option>
                                <option value="Missions">Missions</option>
                                <option value="Outreach">Outreach</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Payment method</label>
                            <select class="form-select"
                                    @bind="formPaymentMethod">
                                <option value="Cash">Cash</option>
                                <option value="EFT">EFT / Bank Transfer</option>
                                <option value="Card">Card</option>
                                <option value="Online">Online</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                    </div>
                </div>

                <div class="card-footer d-flex justify-content-end gap-2">
                    <button class="btn btn-light"
                            @onclick="CloseForm"
                            disabled="@saving">
                        Cancel
                    </button>

                    <button class="btn btn-primary"
                            @onclick="SaveDonationAsync"
                            disabled="@saving">
                        @if (saving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-2"></i>
                            <span>@(editingDonation ? "Save Changes" : "Create Donation")</span>
                        }
                    </button>
                </div>
            </div>
        }

        <!-- DONATION TABLE -->
        <div class="card donation-list-card">
            <div class="donation-toolbar">
                <div>
                    <h5 class="mb-1">Donation Records</h5>
                    <small class="text-muted">
                        @FilteredDonations.Count() record(s)
                    </small>
                </div>

                <div class="donation-filters">
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input class="form-control"
                               placeholder="Search donor or giving type..."
                               @bind="searchTerm"
                               @bind:event="oninput" />
                    </div>

                    <select class="form-select"
                            @bind="selectedPaymentMethod">
                        <option value="All">All payment methods</option>
                        <option value="Cash">Cash</option>
                        <option value="EFT">EFT</option>
                        <option value="Card">Card</option>
                        <option value="Online">Online</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>

            @if (loading)
            {
                <div class="loading-state">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-3 mb-0">Loading donations...</p>
                </div>
            }
            else if (!FilteredDonations.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-wallet2"></i>
                    <h5>No donations found</h5>
                    <p>There are no records matching your search.</p>
                    <button class="btn btn-primary"
                            @onclick="OpenCreateForm">
                        <i class="bi bi-plus-lg me-2"></i>
                        Add Donation
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table donation-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Donor</th>
                                <th>Giving Type</th>
                                <th>Date</th>
                                <th>Payment Method</th>
                                <th class="text-end">Amount</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var donation in FilteredDonations)
                            {
                                <tr>
                                    <td>
                                        <div class="donor-cell">
                                            <div class="donor-avatar">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                            <div>
                                                <strong>
                                                    @(string.IsNullOrWhiteSpace(donation.DonorName)
                                                        ? "Anonymous"
                                                        : donation.DonorName)
                                                </strong>
                                                <small>
                                                    @(string.IsNullOrWhiteSpace(donation.UserId)
                                                        ? "No user linked"
                                                        : ShortenUid(donation.UserId))
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="giving-badge">
                                            @donation.GivingType
                                        </span>
                                    </td>

                                    <td>
                                        <div class="date-cell">
                                            <strong>
                                                @donation.Date.ToString("dd MMM yyyy")
                                            </strong>
                                            <small>
                                                @donation.Date.ToString("HH:mm")
                                            </small>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="payment-method">
                                            <i class="@GetPaymentIcon(donation.PaymentMethod)"></i>
                                            @donation.PaymentMethod
                                        </span>
                                    </td>

                                    <td class="text-end amount-cell">
                                        @donation.Amount.ToString("C2", SouthAfricanCulture)
                                    </td>

                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <button class="btn btn-sm btn-outline-primary"
                                                    title="Edit donation"
                                                    @onclick="() => EditDonation(donation)">
                                                <i class="bi bi-pencil"></i>
                                            </button>

                                            <button class="btn btn-sm btn-outline-danger"
                                                    title="Delete donation"
                                                    @onclick="() => DeleteDonationAsync(donation)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end fw-semibold">
                                    Filtered total
                                </td>
                                <td class="text-end fw-bold">
                                    @FilteredDonations.Sum(d => d.Amount)
                                    .ToString("C2", SouthAfricanCulture)
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    }
</div>


@code {
    private readonly System.Globalization.CultureInfo SouthAfricanCulture =
        System.Globalization.CultureInfo.GetCultureInfo("en-ZA");

    private List<Donation> Donations = new();

    private bool loading = true;
    private bool saving;
    private bool showForm;
    private bool editingDonation;

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private string searchTerm = string.Empty;
    private string selectedPaymentMethod = "All";

    private string formDonationId = string.Empty;
    private string formUserId = string.Empty;
    private string formDonorName = string.Empty;
    private decimal formAmount;
    private DateTime formDate = DateTime.Now;
    private string formGivingType = "General";
    private string formPaymentMethod = "Cash";

    private decimal TotalAmount =>
        Donations.Sum(d => d.Amount);

    private decimal ThisMonthAmount =>
        Donations
            .Where(d => d.Date.Year == DateTime.Now.Year
                     && d.Date.Month == DateTime.Now.Month)
            .Sum(d => d.Amount);

    private IEnumerable<Donation> FilteredDonations =>
        Donations
            .Where(d =>
                string.IsNullOrWhiteSpace(searchTerm)
                || (d.DonorName ?? "").Contains(
                    searchTerm, StringComparison.OrdinalIgnoreCase)
                || (d.GivingType ?? "").Contains(
                    searchTerm, StringComparison.OrdinalIgnoreCase)
                || (d.UserId ?? "").Contains(
                    searchTerm, StringComparison.OrdinalIgnoreCase))
            .Where(d =>
                selectedPaymentMethod == "All"
                || string.Equals(
                    d.PaymentMethod,
                    selectedPaymentMethod,
                    StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(d => d.Date);

    protected override async Task OnInitializedAsync()
    {
        await LoadDonationsAsync();
    }

    private async Task LoadDonationsAsync()
    {
        loading = true;
        errorMessage = string.Empty;

        try
        {
            if (!AuthService.IsAdmin)
            {
                Donations.Clear();
                errorMessage = "Administrator access is required.";
                return;
            }

            Donations = await AuthService.GetDonationsAsync()
                ?? new List<Donation>();
        }
        catch (Exception ex)
        {
            errorMessage = GetFriendlyError(ex);
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenCreateForm()
    {
        ClearMessages();

        editingDonation = false;
        formDonationId = string.Empty;
        formUserId = string.Empty;
        formDonorName = string.Empty;
        formAmount = 0;
        formDate = DateTime.Now;
        formGivingType = "General";
        formPaymentMethod = "Cash";

        showForm = true;
    }

    private void EditDonation(Donation donation)
    {
        ClearMessages();

        editingDonation = true;
        formDonationId = donation.DonationId;
        formUserId = donation.UserId;
        formDonorName = donation.DonorName;
        formAmount = donation.Amount;
        formDate = donation.Date;
        formGivingType = donation.GivingType;
        formPaymentMethod = donation.PaymentMethod;

        showForm = true;
    }

    private async Task SaveDonationAsync()
    {
        ClearMessages();

        if (formAmount <= 0)
        {
            errorMessage = "Enter an amount greater than zero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(formDonorName))
        {
            formDonorName = "Anonymous";
        }

        saving = true;

        try
        {
            var donation = new Donation
            {
                DonationId = formDonationId,
                UserId = formUserId.Trim(),
                Amount = formAmount,
                Date = formDate,
                DonorName = formDonorName.Trim(),
                GivingType = formGivingType,
                PaymentMethod = formPaymentMethod
            };

            if (editingDonation)
            {
                await AuthService.UpdateDonationAsync(donation);
                successMessage = "Donation updated successfully.";
            }
            else
            {
                await AuthService.CreateDonationAsync(donation);
                successMessage = "Donation created successfully.";
            }

            showForm = false;
            await LoadDonationsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = GetFriendlyError(ex);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteDonationAsync(Donation donation)
    {
        ClearMessages();

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete the donation record for {donation.DonorName} " +
            $"({donation.Amount.ToString("C2", SouthAfricanCulture)})?");

        if (!confirmed)
        {
            return;
        }

        try
        {
            await AuthService.DeleteDonationAsync(donation.DonationId);
            Donations.Remove(donation);
            successMessage = "Donation record deleted successfully.";
        }
        catch (Exception ex)
        {
            errorMessage = GetFriendlyError(ex);
        }
    }

    private void CloseForm()
    {
        if (!saving)
        {
            showForm = false;
        }
    }

    private void ClearMessages()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private string ShortenUid(string uid)
    {
        if (string.IsNullOrWhiteSpace(uid))
        {
            return "N/A";
        }

        return uid.Length <= 16
            ? uid
            : $"{uid[..8]}...{uid[^6..]}";
    }

    private string GetPaymentIcon(string? method)
    {
        return method?.ToLowerInvariant() switch
        {
            "cash" => "bi bi-cash",
            "eft" => "bi bi-bank",
            "card" => "bi bi-credit-card",
            "online" => "bi bi-globe",
            _ => "bi bi-wallet2"
        };
    }

    private string GetFriendlyError(Exception ex)
    {
        var message = ex.Message;

        if (message.Contains(
            "Missing or insufficient permissions",
            StringComparison.OrdinalIgnoreCase))
        {
            return "Firebase denied this operation. Check your Firestore Security Rules and confirm that you are logged in as an administrator.";
        }

        if (message.Contains(
            "You must be logged in",
            StringComparison.OrdinalIgnoreCase))
        {
            return "Your Firebase session is not available. Log in again and retry.";
        }

        return message;
    }
}