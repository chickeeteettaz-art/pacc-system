@page "/admin/dashboard"

@layout AdminLayout

@using pacc_system_test_one.Services

@inject FirebaseAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Admin Dashboard</PageTitle>


@if (loading)
{
    <div class="dashboard-loading">

        <div class="spinner-border text-primary"
             role="status">
        </div>

        <p>
            Loading administration dashboard...
        </p>

    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="dashboard-error">

        <div class="dashboard-error-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>

        <div class="dashboard-error-content">

            <h5>
                Unable to load dashboard
            </h5>

            <p>
                @errorMessage
            </p>

            <button class="btn btn-primary"
                    @onclick="LoadDashboardAsync">

                <i class="bi bi-arrow-clockwise me-2"></i>

                Try Again

            </button>

        </div>

    </div>
}
else if (!isAdmin)
{
    <div class="alert alert-danger">

        <i class="bi bi-shield-exclamation me-2"></i>

        You do not have permission to access the administration area.

    </div>
}
else
{
    <!-- HEADER -->

    <div class="page-header m-4">

        <div>

            <div class="page-breadcrumb">
                Administration
                <span>/</span>
                Dashboard
            </div>

            <h1 class="page-title">
                Admin Dashboard
            </h1>

            <p class="page-description">
                Manage the Christian Centre platform.
            </p>

        </div>

    </div>


    <!-- STATISTICS -->

    <div class="row g-4 m-4">

        <!-- USERS -->

        <div class="col-md-6 col-xl-3">

            <div class="dashboard-stat-card">

                <div class="dashboard-stat-icon users">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div>

                    <span>
                        Total Users
                    </span>

                    <h2>
                        @stats.Users
                    </h2>

                </div>

            </div>

        </div>


        <!-- DONATIONS -->

        <div class="col-md-6 col-xl-3">

            <div class="dashboard-stat-card">

                <div class="dashboard-stat-icon donations">
                    <i class="bi bi-wallet2"></i>
                </div>

                <div>

                    <span>
                        Donations
                    </span>

                    <h2>
                        @stats.Donations
                    </h2>

                </div>

            </div>

        </div>


        <!-- SERMONS -->

        <div class="col-md-6 col-xl-3">

            <div class="dashboard-stat-card">

                <div class="dashboard-stat-icon sermons">
                    <i class="bi bi-play-circle-fill"></i>
                </div>

                <div>

                    <span>
                        Sermons
                    </span>

                    <h2>
                        @stats.Sermons
                    </h2>

                </div>

            </div>

        </div>


        <!-- MESSAGES -->

        <div class="col-md-6 col-xl-3">

            <div class="dashboard-stat-card">

                <div class="dashboard-stat-icon messages">
                    <i class="bi bi-chat-dots-fill"></i>
                </div>

                <div>

                    <span>
                        Messages
                    </span>

                    <h2>
                        @stats.Messages
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- SECOND ROW -->

    <div class="row g-4 m-4">

        <div class="col-md-6 col-xl-3">

            <div class="dashboard-mini-card">

                <i class="bi bi-megaphone-fill"></i>

                <div>

                    <span>
                        Announcements
                    </span>

                    <strong>
                        @stats.Announcements
                    </strong>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="dashboard-mini-card">

                <i class="bi bi-images"></i>

                <div>

                    <span>
                        Gallery Images
                    </span>

                    <strong>
                        @stats.Gallery
                    </strong>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="dashboard-mini-card">

                <i class="bi bi-heart-fill"></i>

                <div>

                    <span>
                        Prayer Requests
                    </span>

                    <strong>
                        @stats.PrayerRequests
                    </strong>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="dashboard-mini-card">

                <i class="bi bi-people-fill"></i>

                <div>

                    <span>
                        Outreach Programs
                    </span>

                    <strong>
                        @stats.OutreachPrograms
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- QUICK ACTIONS -->

    <div class="dashboard-section-card m-4">

        <div class="dashboard-section-header">

            <div>

                <h4>
                    Administration
                </h4>

                <p>
                    Quickly access the different management areas.
                </p>

            </div>

            <i class="bi bi-speedometer2"></i>

        </div>


        <div class="row g-3">

            <div class="col-md-6 col-lg-3">

                <a href="/admin/users"
                   class="dashboard-action">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Manage Users
                    </span>

                </a>

            </div>


            <div class="col-md-6 col-lg-3">

                <a href="/admin/announcements"
                   class="dashboard-action">

                    <i class="bi bi-megaphone-fill"></i>

                    <span>
                        Announcements
                    </span>

                </a>

            </div>


            <div class="col-md-6 col-lg-3">

                <a href="/admin/sermons"
                   class="dashboard-action">

                    <i class="bi bi-play-circle-fill"></i>

                    <span>
                        Manage Sermons
                    </span>

                </a>

            </div>


            <div class="col-md-6 col-lg-3">

                <a href="/admin/gallery"
                   class="dashboard-action">

                    <i class="bi bi-images"></i>

                    <span>
                        Manage Gallery
                    </span>

                </a>

            </div>


            <div class="col-md-6 col-lg-3">

                <a href="/admin/messages"
                   class="dashboard-action">

                    <i class="bi bi-chat-dots-fill"></i>

                    <span>
                        Messages
                    </span>

                </a>

            </div>


            <div class="col-md-6 col-lg-3">

                <a href="/admin/prayer-requests"
                   class="dashboard-action">

                    <i class="bi bi-heart-fill"></i>

                    <span>
                        Prayer Requests
                    </span>

                </a>

            </div>


            <div class="col-md-6 col-lg-3">

                <a href="/admin/outreach"
                   class="dashboard-action">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Outreach
                    </span>

                </a>

            </div>


            <div class="col-md-6 col-lg-3">

                <a href="/admin/donations"
                   class="dashboard-action">

                    <i class="bi bi-wallet2"></i>

                    <span>
                        Donations
                    </span>

                </a>

            </div>

        </div>

    </div>
}


@code {

    private bool loading = true;

    private bool isAdmin;

    private string errorMessage = "";

    private FirebaseAuthService.DashboardStats stats =
        new FirebaseAuthService.DashboardStats();


    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }


    private async Task LoadDashboardAsync()
    {
        loading = true;

        errorMessage = "";

        try
        {
            var user =
                await AuthService.LoadCurrentUserAsync();

            if (user == null)
            {
                Navigation.NavigateTo(
                    "/login",
                    true);

                return;
            }


            isAdmin =
                user.UserType.Equals(
                    "Admin",
                    StringComparison.OrdinalIgnoreCase);


            if (!isAdmin)
            {
                Navigation.NavigateTo(
                    "/user/dashboard",
                    true);

                return;
            }


            stats =
                await AuthService.GetDashboardStatsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"ADMIN DASHBOARD ERROR: {ex}");

            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}