@page "/login"
@layout AuthLayout
@using pacc_system_test_one.Services

@inject FirebaseAuthService AuthService
@inject NavigationManager Navigation

<div class="login-page">

    <!-- Left Branding Panel -->
    <div class="login-branding">
        <div class="branding-content">
            <div class="logo">
                <div class="logo-icon">
                    <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="20" cy="20" r="18" stroke="white" stroke-width="2.5" />
                        <path d="M20 8V32M12 16H28" stroke="white" stroke-width="2.8" stroke-linecap="round" />
                    </svg>
                </div>
                <div>
                    <h1>CHRISTIAN CENTRE</h1>
                    <p>A PLACE OF HOPE, FAITH & FAMILY</p>
                </div>
            </div>

            <div class="branding-text">
                <h2>Welcome Home</h2>
                <p>Stay connected with your church community. Access sermons, services, prayer requests and more.</p>
            </div>

            <div class="branding-footer">
                <p>Real People. Real Faith.<br />A Greater Purpose.</p>
            </div>
        </div>
    </div>

    <!-- Right Login Form -->
    <div class="login-form-side">
        <div class="login-card">

            <div class="login-header">
                <div class="welcome-emoji">👋</div>
                <h1>Welcome Back</h1>
                <p class="login-subtitle">
                    Sign in to stay connected with your church community.
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="error-message">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                    <span>@errorMessage</span>
                </div>
            }

            <div class="form-group">
                <label>Email Address</label>
                <div class="input-wrapper">
                    <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                        <polyline points="22,6 12,13 2,6" />
                    </svg>
                    <input type="email"
                           class="form-control"
                           placeholder="Enter your email address"
                           @bind="email" />
                </div>
            </div>

            <div class="form-group">
                <div class="password-label">
                    <label>Password</label>
                    <a href="/forgot-password" class="forgot-link">Forgot password?</a>
                </div>
                <div class="input-wrapper">
                    <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <input type="password"
                           class="form-control"
                           placeholder="Enter your password"
                           @bind="password" />
                </div>
            </div>

            <div class="remember-me">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="rememberMe" />
                    <span class="checkmark"></span>
                    <span>Remember me</span>
                </label>
            </div>

            <button class="btn-login"
                    @onclick="LoginAsync"
                    disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner"></span>
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Sign In</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                }
            </button>

            <div class="divider">
                <span>OR</span>
            </div>

            <p class="register-text">Don't have an account?</p>

            <button class="btn-register" @onclick="GoToRegister">
                Create an Account
            </button>

            <div class="secure-text">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                Your information is securely protected.
            </div>
        </div>
    </div>
</div>


@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private bool rememberMe;
    private bool isLoading;
    private string errorMessage = string.Empty;

    private async Task LoginAsync()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Please enter your email address.";
            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter your password.";
            return;
        }

        isLoading = true;

        try
        {
            var user = await AuthService.LoginAsync(email, password);

            if (user == null)
            {
                errorMessage = "Unable to retrieve your account.";
                return;
            }

            if (user.UserType.Equals("Admin", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/admin/dashboard", true);
            }
            else
            {
                Navigation.NavigateTo("/user/dashboard", true);
            }
        }
        catch (Exception ex)
        {
            errorMessage = GetFirebaseError(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToRegister()
    {
        Navigation.NavigateTo("/register");
    }

    private string GetFirebaseError(string error)
    {
        if (error.Contains("INVALID_LOGIN_CREDENTIALS"))
            return "Incorrect email or password.";

        if (error.Contains("EMAIL_NOT_FOUND"))
            return "No account exists with this email.";

        if (error.Contains("INVALID_PASSWORD"))
            return "Incorrect password.";

        if (error.Contains("TOO_MANY_ATTEMPTS"))
            return "Too many attempts. Please try again later.";

        return error;
    }
}