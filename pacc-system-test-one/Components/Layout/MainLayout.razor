@inherits LayoutComponentBase

<div class="app-shell">

    <!-- Sidebar -->
    <aside class="sidebar shadow-sm">

        <NavMenu />

    </aside>

    <!-- Main Area -->
    <div class="main-area">

        <!-- Top Header -->
        <header class="top-header border-bottom">

            <div class="container-fluid px-4">

                <div class="d-flex align-items-center justify-content-between">

                    <!-- Mobile menu -->
                    <button class="btn btn-light d-lg-none mobile-menu-btn"
                            type="button"
                            @onclick="ToggleSidebar">

                        <i class="bi bi-list fs-4"></i>

                    </button>

                    <!-- Page greeting -->
                    <div class="header-welcome d-none d-md-block">

                        <div class="text-muted small">
                            Welcome back
                        </div>

                        <div class="fw-semibold">
                            Palesa 👋
                        </div>

                    </div>

                    <!-- Header actions -->
                    <div class="d-flex align-items-center gap-3 ms-auto">

                        <!-- Search -->
                        <button class="btn search-button d-none d-md-flex align-items-center gap-2">

                            <i class="bi bi-search"></i>

                            <span>
                                Search
                            </span>

                        </button>

                        <!-- Notifications -->
                        <button class="btn notification-button position-relative">

                            <i class="bi bi-bell fs-5"></i>

                            <span class="position-absolute top-0 start-100 translate-middle
                                badge rounded-pill bg-danger notification-badge">

                                3

                            </span>

                        </button>

                        <!-- User -->
                        <div class="dropdown">

                            <button class="btn user-menu dropdown-toggle d-flex align-items-center gap-2"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <div class="user-avatar">
                                    P
                                </div>

                                <div class="text-start d-none d-md-block">

                                    <div class="fw-semibold small">
                                        Palesa
                                    </div>

                                    <div class="text-muted user-role">
                                        Member
                                    </div>

                                </div>

                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">

                                <li>
                                    <a class="dropdown-item"
                                       href="/profile">

                                        <i class="bi bi-person me-2"></i>

                                        Profile

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       href="/messages">

                                        <i class="bi bi-chat-dots me-2"></i>

                                        Messages

                                    </a>
                                </li>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>
                                    <a class="dropdown-item text-danger"
                                       href="/logout">

                                        <i class="bi bi-box-arrow-right me-2"></i>

                                        Logout

                                    </a>
                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </div>

        </header>

        <!-- Page Content -->
        <main class="page-content">

            <div class="container-fluid px-4 py-4">

                @Body

            </div>

        </main>

    </div>

</div>

@code {

    private bool sidebarOpen;

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }

}