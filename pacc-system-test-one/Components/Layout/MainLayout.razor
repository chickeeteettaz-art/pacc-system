@inherits LayoutComponentBase
@using pacc_system_test_one.Services
@inject FirebaseAuthService AuthService
@inject NavigationManager Navigation

<div class="user-layout">

    <!-- ==========================================
         SIDEBAR
         ========================================== -->

    <aside class="@($"user-sidebar {(sidebarOpen ? "user-sidebar-open" : "")}")">

        <NavMenu />

    </aside>


    <!-- Mobile overlay -->
    @if (sidebarOpen)
    {
        <div class="user-sidebar-overlay"
             @onclick="CloseSidebar">
        </div>
    }


    <!-- ==========================================
         MAIN CONTENT
         ========================================== -->

    <div class="user-main">

        <!-- ==========================================
             TOP HEADER
             ========================================== -->

        <header class="user-header">

            <div class="user-header-inner">

                <!-- Mobile menu -->

                <button type="button"
                        class="user-mobile-button"
                        @onclick="ToggleSidebar">

                    <i class="bi bi-list"></i>

                </button>


                <!-- Welcome -->

                <div class="user-header-welcome">

                    <span class="user-header-small">
                        Welcome back
                    </span>

                    <strong>
                        @DisplayName
                        <span class="user-wave">👋</span>
                    </strong>

                </div>


                <!-- Header actions -->

                <div class="user-header-actions">

                    <!-- Search -->

                    <button type="button"
                            class="user-search-button">

                        <i class="bi bi-search"></i>

                        <span>Search</span>

                    </button>


                    <!-- Notifications -->

                    <button type="button"
                            class="user-header-icon-button user-notification-button">

                        <i class="bi bi-bell"></i>

                        <span class="user-notification-count">
                            3
                        </span>

                    </button>


                    <!-- Divider -->

                    <div class="user-header-divider"></div>


                    <!-- User menu -->

                    <div class="dropdown">

                        <button type="button"
                                class="user-account-button dropdown-toggle"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <div class="user-account-avatar">
                                @UserInitials
                            </div>

                            <div class="user-account-details">

                                <strong>
                                    @DisplayName
                                </strong>

                                <span>
                                    User
                                </span>

                            </div>

                        </button>


                        <ul class="dropdown-menu dropdown-menu-end user-account-dropdown">

                            <li class="user-dropdown-profile">

                                <div class="user-dropdown-avatar">
                                    @UserInitials
                                </div>

                                <div>

                                    <strong>
                                        @DisplayName
                                    </strong>

                                    <span>
                                        @AuthEmail
                                    </span>

                                </div>

                            </li>


                            <li>
                                <hr class="dropdown-divider" />
                            </li>


                            <li>

                                <a class="dropdown-item"
                                   href="/profile">

                                    <i class="bi bi-person"></i>

                                    <span>
                                        Profile
                                    </span>

                                </a>

                            </li>


                            <li>

                                <a class="dropdown-item"
                                   href="/messages">

                                    <i class="bi bi-chat-left-text"></i>

                                    <span>
                                        Messages
                                    </span>

                                </a>

                            </li>


                            <li>
                                <hr class="dropdown-divider" />
                            </li>


                            <li>

                                <button type="button"
                                        class="dropdown-item user-dropdown-logout"
                                        @onclick="LogoutAsync">

                                    <i class="bi bi-box-arrow-right"></i>

                                    <span>
                                        Logout
                                    </span>

                                </button>

                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </header>


        <!-- ==========================================
             PAGE CONTENT
             ========================================== -->

        <main class="user-page">

            <div class="user-page-container">

                @Body

            </div>

        </main>

    </div>

</div>


@code {

    private bool sidebarOpen;

    private string DisplayName = "User";

    private string AuthEmail = "";

    private string UserInitials = "U";


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = AuthService.CurrentUser;

            if (user == null)
            {
                user = await AuthService.LoadCurrentUserAsync();
            }

            if (user != null)
            {
                AuthEmail = user.EmailAddress ?? "";

                if (!string.IsNullOrWhiteSpace(user.FirstName))
                {
                    DisplayName = user.FirstName;
                }
                else if (!string.IsNullOrWhiteSpace(user.EmailAddress))
                {
                    DisplayName = AuthService.GetDisplayName(user.EmailAddress);
                }

                UserInitials = GetInitials(
                    user.FirstName,
                    user.LastName,
                    DisplayName
                );
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Unable to load user information: {ex.Message}"
            );
        }
    }


    private string GetInitials(
        string? firstName,
        string? lastName,
        string fallback)
    {
        var initials = "";

        if (!string.IsNullOrWhiteSpace(firstName))
        {
            initials += firstName[0];
        }

        if (!string.IsNullOrWhiteSpace(lastName))
        {
            initials += lastName[0];
        }

        if (string.IsNullOrWhiteSpace(initials) &&
            !string.IsNullOrWhiteSpace(fallback))
        {
            var parts = fallback
                .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries
                );

            foreach (var part in parts.Take(2))
            {
                initials += part[0];
            }
        }

        return string.IsNullOrWhiteSpace(initials)
            ? "U"
            : initials.ToUpper();
    }


    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }


    private void CloseSidebar()
    {
        sidebarOpen = false;
    }


    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();

        Navigation.NavigateTo(
            "/login",
            true
        );
    }

}